# Hugging Face User Access Token
# Create one at https://huggingface.co/settings/tokens
# Fine-grained token needs: "Make calls to Inference Providers"
HF_TOKEN=hf_your_token_here

# GitHub — repo scope so Forge can read files and commit/push
# GITHUB_TOKEN=ghp_your_token_here

# Or GitHub OAuth app (callback: https://YOUR_DOMAIN/api/github/callback)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
